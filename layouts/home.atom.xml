{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\"?>" | safeHTML }}
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.Title }}</title>
  <link href="{{ site.Home.Permalink }}atom.xml" rel="self" type="application/atom+xml"/>
  <link href="{{ site.Home.Permalink }}" rel="alternate" type="text/html"/>
  <id>{{ site.Home.Permalink }}atom.xml</id>
  <updated>{{ (index site.RegularPages.ByDate.Reverse 0).Date.Format "2006-01-02T15:04:05Z07:00" }}</updated>
  {{- range first 25 site.RegularPages.ByDate.Reverse }}
  <entry>
    <title>{{ .Title }}</title>
    <link href="{{ .Permalink }}" rel="alternate" type="text/html"/>
    <id>{{ .Permalink }}</id>
    <published>{{ .Date.Format "2006-01-02T15:04:05Z07:00" }}</published>
    <updated>{{ .Lastmod.Format "2006-01-02T15:04:05Z07:00" }}</updated>
    {{- with .Description }}<summary>{{ . }}</summary>{{ end }}
    <content type="html">{{ .Content }}</content>
  </entry>
  {{- end }}
</feed>
